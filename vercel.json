{
  "rewrites": [
    { "source": "/login.html", "destination": "/app/adapters/www/pages/Login/page.html" },
    { "source": "/account-loading.html", "destination": "/app/adapters/www/pages/AccountLoading/page.html" },
    { "source": "/vagas.html", "destination": "/app/adapters/www/pages/Vagas/page.html" },
    { "source": "/denuncia.html", "destination": "/app/adapters/www/pages/Denuncia/page.html" },
    { "source": "/clima.html", "destination": "/app/adapters/www/pages/Clima/page.html" },
    { "source": "/chamados.html", "destination": "/app/adapters/www/pages/Chamados/page.html" },
    { "source": "/feedbacks.html", "destination": "/app/adapters/www/pages/Feedbacks/page.html" },
    { "source": "/atestados.html", "destination": "/app/adapters/www/pages/Atestados/page.html" },
    { "source": "/candidatura.html", "destination": "/app/adapters/www/pages/Candidatura/page.html" },
    { "source": "/documentos-fredy.html", "destination": "/app/adapters/www/pages/DocumentosFredy/page.html" },
    { "source": "/documentos-besten.html", "destination": "/app/adapters/www/pages/DocumentosBesten/page.html" },
    { "source": "/documentos-achei.html", "destination": "/app/adapters/www/pages/DocumentosAchei/page.html" },
    { "source": "/documentos-trinca.html", "destination": "/app/adapters/www/pages/DocumentosTrinca/page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Access-Control-Allow-Origin", "value": "https://hub-opal-nine.vercel.app" }
      ]
    }
  ]
}

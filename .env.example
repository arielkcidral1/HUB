DATABASE_URL=postgresql://USUARIO:SENHA@psql-fredyrh.postgres.database.azure.com:5432/fredyrh?sslmode=require

# Alternativas aceitas para DATABASE_URL (usa a primeira que estiver definida):
# AZURE_POSTGRES_URL=
# POSTGRES_URL=

# Opcional: tamanho maximo do pool de conexoes do pg (padrao: 1)
# POSTGRES_POOL_MAX=1

# Opcional: chave usada para assinar o cookie de sessao (HMAC). Sem ela, o
# servidor deriva uma chave estavel a partir da DATABASE_URL. Recomendado
# gerar uma propria em producao, ex: openssl rand -hex 32
# SESSION_SECRET=
